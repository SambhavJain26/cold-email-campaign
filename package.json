{
  "name": "cold-email-campaign",
  "private": true,
  "version": "0.0.0",
  "description": "Single-operator cold email campaign tool - event-sourced core, SMTP/IMAP transport, React dashboard",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @coldemail/server",
    "db:rollback": "npm run db:rollback -w @coldemail/server",
    "db:status": "npm run db:status -w @coldemail/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "rebuild-projections": "npm run rebuild-projections -w @coldemail/server --",
    "test:golden": "vitest run --project golden"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
