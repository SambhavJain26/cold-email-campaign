{
  "name": "@coldemail/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "API + workers: Fastify, Drizzle, pg-boss - event-sourced core",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/cli.ts up",
    "db:rollback": "tsx src/db/cli.ts down",
    "db:status": "tsx src/db/cli.ts status",
    "rebuild-projections": "tsx src/services/rebuildCli.ts",
    "rotate-secrets": "tsx src/services/rotateSecretsCli.ts",
    "self-check": "tsx src/services/selfCheckCli.ts",
    "golden:export": "tsx test/fixtures/golden/export-api-fixtures.ts"
  },
  "dependencies": {
    "@coldemail/shared": "*",
    "@fastify/multipart": "^9.4.0",
    "@fastify/secure-session": "^8.3.0",
    "@node-rs/argon2": "^2.0.2",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0"
  }
}
